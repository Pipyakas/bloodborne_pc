# Native Linux build of master on the build host (tools/cross/build-linux.sh). Arch's current
# Vulkan headers and libraries; the header-only packages Arch lacks come from their releases.
FROM docker.io/library/archlinux:latest
RUN pacman -Syu --noconfirm --needed base-devel clang lld cmake ninja pkgconf python git glslang \
    vulkan-headers vulkan-icd-loader sdl3 boost fmt zydis miniz robin-map ffmpeg xxhash spirv-headers \
    && pacman -Scc --noconfirm
RUN for spec in Neargye/magic_enum:v0.9.7 GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator:v3.3.0 herumi/xbyak:v7.24.2; do \
        repo=${spec%%:*} tag=${spec##*:} dir=/tmp/${repo##*/} \
        && git clone -q --depth 1 --branch "$tag" "https://github.com/$repo.git" "$dir" \
        && cmake -S "$dir" -B "$dir/build" -G Ninja -DCMAKE_INSTALL_PREFIX=/usr/local \
           -DMAGIC_ENUM_OPT_BUILD_EXAMPLES=OFF -DMAGIC_ENUM_OPT_BUILD_TESTS=OFF >/dev/null \
        && cmake --install "$dir/build" >/dev/null && rm -rf "$dir" || exit 1; \
    done
